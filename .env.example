# 灵镜 — 环境变量样板。复制为 .env 并填入真实值:cp .env.example .env && chmod 600 .env
# ⚠️ .env 已被 .gitignore 忽略,绝不提交;密钥也不要贴进聊天/PR。
#
# 标注约定:
#   【必填】缺则服务/容器拒启      【生产必填】托管 SaaS 上线必须    【可选】留空走代码默认
# docker compose 会强校验【必填】+【生产必填】(缺则 up 报错)。本地裸跑只需【必填】+ 选填 OSS。

# ════════════════════════════════════════════════════════
#  1. 平台超管(/admin 登录入口)
# ════════════════════════════════════════════════════════
# 【仅首启用】首次启动 platform_admin 表空时,用这两个建初始超管(密码 bcrypt 哈希入库,
# 不存明文)。建完即不再读取——表非空时本段被跳过,缺 SUPERADMIN_PASS 也不影响后续启动。
# ✅ 最佳实践:首次部署成功登录 /admin 后,把 SUPERADMIN_PASS 清空(或改密改在后台改),
#    避免初始密码长期明文留在 .env。改密请在 /admin 后台,别靠改这里(改这里对已建超管无效)。
SUPERADMIN_USER=admin
SUPERADMIN_PASS=

# ════════════════════════════════════════════════════════
#  2. 厂商 API Key — 只有百炼放这里(冷启动种子);火山/Google 在 /admin 配
# ════════════════════════════════════════════════════════
# 平台接了 3 个厂商:阿里百炼 / 火山方舟 / Google AI Studio。三者的 key 都在
#   /admin →「厂商 / Key」页粘贴(AES-256-GCM 加密入库,只显尾号)。
# 唯独「百炼」可在这里填,是因为全新部署首启要用它种子 provider 表(冷启动)。
# 火山、Google 无 .env 回落,只能在后台配——它们不需要写进 .env。
#
# 【冷启动必填,之后可移到后台】百炼 API Key。运行时取 key 的顺序是「库内密文(解密)优先,
# 回落 .env」。全新部署 DB 为空,首启迁移会用此 key 种子 provider 表;若同时配了 MASTER_KEY,
# 则加密入库。所以:
#   - 新机第一次起:必须在这里填(否则 provider 表种不进 key,AI 全失败)。
#   - 起来之后:可在 /admin「厂商」页粘贴 key(加密入库),再把这里清空——库内为准,.env 仅回落。
# ✅ 推荐:配上 MASTER_KEY,key 加密入库,admin 也只看到 last4;.env 这行用完即清更安全。
DASHSCOPE_API_KEY=
# 【可选】覆盖端点(私有化/区域端点时用),默认即官方公网端点。
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
# 【强烈建议】主密钥:AES-256-GCM 加密厂商 API key 存库(admin 不见明文,只回显 last4)。
# 生成:openssl rand -base64 32 。未配则 key 明文回落 .env(可用但不安全)。生产务必配。
MASTER_KEY=

# ════════════════════════════════════════════════════════
#  3. 阿里云 OSS — 对象存储(生产必需)
# ════════════════════════════════════════════════════════
# wan2.2-s2v 要从公网下载素材,百炼云端必须能拉到 → 生产必须用 OSS。
# 四项缺一不可:都非空才启用 OSS;否则生成会卡 pending 超时。
# 与 ECS 同地域;桶设公共读;AccessKey 可复用 DashScope 同账号 RAM 用户(授权 AliyunOSSFullAccess)。
OSS_REGION=oss-cn-hangzhou      # 纯 region 名,别填完整 URL
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# ════════════════════════════════════════════════════════
#  4. Docker 生产部署(docker compose / scripts/deploy.sh)— 见 DEPLOY-ALIYUN.md
# ════════════════════════════════════════════════════════
# 【生产必填】域名:A 记录须先指向服务器公网 IP(Caddy 自动申 Let's Encrypt 证书)。
LJ_DOMAIN=lingjing.example.com
LJ_ACME_EMAIL=ops@example.com    # 证书到期通知邮箱(可选)
# cookie Secure:生产经 Caddy HTTPS 必须 true;本地裸 HTTP 开发设 false(否则登不进)。
COOKIE_SECURE=true
# 时区:审计/积分时间戳按此。
TZ=Asia/Shanghai

# ════════════════════════════════════════════════════════
#  5. 运行/队列调优(均可选,留空走默认)
# ════════════════════════════════════════════════════════
PORT=9372                       # app 监听端口(compose 内部用,默认 9372)
DB_FILE=/data/lingjing.db       # SQLite 库路径(容器内卷;本地开发可设 ./lingjing.db)
WORKER_POOL_SIZE=16             # worker 并发池:最多同时处理几个生成任务。4c8g 压不住可调 8
# WORKER_TENANT_MAX=            # 单租户并发上限(默认 ceil(池/2),防大客户饿死小客户)
# WORKER_QUEUED_TIMEOUT_MS=     # 任务排队超时(默认见代码)
# POLL_INTERVAL_MS=3000         # 轮询百炼任务状态的间隔
# POLL_TIMEOUT_MS=600000        # 数字人/图片任务轮询总超时(10 分钟)
# VIDEO_T2V_TIMEOUT_MS=900000   # 文生视频任务超时(15 分钟,比 s2v 长)
# BAICHUAN_JOB_MODE=poll        # 百炼任务模式(默认 poll 异步轮询)

# ════════════════════════════════════════════════════════
#  6. 百炼模型名(均可选,留空走代码默认 = 下方注释里的值)
# ════════════════════════════════════════════════════════
# 数字人(音频驱动口型)。文案先经 Qwen-TTS 转音频,再喂 wan2.2-s2v(image_url+audio_url)。
# BAICHUAN_AVATAR_MODEL=wan2.2-s2v
# TTS(文字转语音):Qwen-TTS。普通合成 / 带情绪指令两档。
# BAICHUAN_QWEN_TTS_MODEL=qwen3-tts-flash
# BAICHUAN_QWEN_INSTRUCT_MODEL=qwen3-tts-instruct-flash
# 声音复刻(克隆本人声音)/ 设计音色:
# BAICHUAN_VC_MODEL=qwen3-tts-vc-2026-01-22
# BAICHUAN_DESIGN_MODEL=qwen3-tts-vd-2026-01-26
# AI 图片:文生图 qwen-image(异步多图)/ 图生图 qwen-image-edit(同步)。
# BAICHUAN_IMAGE_MODEL=qwen-image
# BAICHUAN_IMAGE_EDIT_MODEL=qwen-image-edit
# AI 音乐:
# BAICHUAN_FUN_MUSIC_MODEL=fun-music-v1
