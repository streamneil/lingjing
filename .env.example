# 灵镜 环境变量。复制填值:cp .env.example .env && chmod 600 .env  (.env 已 gitignore,勿提交)
# 标注:[必填] 缺则拒启   [可选] 留空走默认。详尽说明见 DEPLOY-ALIYUN.md。

# ── 平台超管(/admin 登录)──
SUPERADMIN_USER=admin
SUPERADMIN_PASS=                 # [必填] 超管初始密码,仅首启建号用;之后可清空,改密在 /admin

# ── 密钥 ──
# 厂商 API Key(百炼/火山/Google)不在这里配,全部在 /admin →「厂商 / Key」页粘贴。
# [必填] 主密钥:加密上面那些厂商 key 存库用(不是厂商的 key,自己生成)。生成:openssl rand -base64 32
#        没它则 /admin 贴 key 会失败;用上后别再改(改了旧密文解不开)。
MASTER_KEY=

# [可选] Gemini(Nano Banana)出网代理。中国大陆 ECS 直连 Google 被墙时填,只作用于 Gemini,
# 百炼/火山/OSS 仍直连。容器内 127.0.0.1≠宿主机:宿主机跑 clash(7890)时用 host.docker.internal
# (需在 docker-compose 的 app 服务加 extra_hosts: ["host.docker.internal:host-gateway"],
# 且 clash 设 allow-lan 让容器可达;7890 务必在安全组对公网封闭)。不填 = 直连(本地开发)。
# GEMINI_PROXY=http://host.docker.internal:7890

# [可选] OpenAI(GPT Image 2)出网代理。同 GEMINI_PROXY:中国大陆 ECS 直连 api.openai.com 被墙时填,
# 只作用于 OpenAI 网关,百炼/火山/Gemini/OSS 不受影响。不填 = 直连(本地开发)。
# OPENAI_PROXY=http://host.docker.internal:7890

# ── 在线支付(微信支付 / 支付宝)──
# 平台公网基址:支付回调(notify_url)与支付返回页的地址来源。通常 = https://$LJ_DOMAIN。
# [在线支付必填] 不填则收银台微信/支付宝一律显示「敬请期待」(对公转账不受影响)。
# 商户号/密钥不在这里配 —— 在 /admin →「在线支付」页填(经 MASTER_KEY 加密落库)。
PUBLIC_BASE_URL=                  # 例:https://lingjing.example.com(线上真实域名,https、结尾不带 /)
# [可选] 微信/支付宝出网代理(境内服务器通常直连可达,一般不用填;境外服务器按需)。
# WECHAT_PROXY=http://host.docker.internal:7890
# ALIPAY_PROXY=http://host.docker.internal:7890

# ── 阿里云 OSS(生产对象存储,四项缺一不可)──
# 与 ECS 同地域;桶设公共读;AccessKey 授权 AliyunOSSFullAccess。
OSS_REGION=oss-cn-hangzhou       # [必填] 纯 region 名,别填完整 URL
OSS_BUCKET=                      # [必填] 桶名,如 lh-lingjing(全局唯一)
OSS_ACCESS_KEY_ID=               # [必填] 阿里云 AccessKey ID,LTAI 开头
OSS_ACCESS_KEY_SECRET=           # [必填] 与上面 AK ID 配对的 Secret

# ── 短信验证码登录(阿里云 Dysmsapi)──
# 留空则验证码打到服务端日志(ConsoleSmsSender,仅供开发/联调;签名审批前可先上线)。
# 签名 + 模板需在阿里云短信控制台单独申请审核(1-3 工作日);AK 可复用上方 OSS 同账号(RAM 授权短信)。
SMS_PROVIDER=                    # [可选] 留空=自动(配齐则 aliyun,否则 console);可显式 aliyun / console
SMS_SIGN_NAME=                   # [可选] 审核通过的短信签名(如「灵镜」)
SMS_TEMPLATE_CODE=               # [可选] 模板 CODE(模板含 ${code} 变量),如 SMS_123456789
# SMS_ALIYUN_AK_ID=              # [可选] 不填则复用 OSS_ACCESS_KEY_ID
# SMS_ALIYUN_AK_SECRET=          # [可选] 不填则复用 OSS_ACCESS_KEY_SECRET
# SMS_IP_DAILY_CAP=60            # [可选] 每 IP 日发送上限(政企 NAT 共用出口,默认放宽到 60)
# SMS_PHONE_DAILY_CAP=10         # [可选] 每手机号日发送上限(主闸)

# ── Docker 部署(HTTPS / 域名)──
LJ_DOMAIN=lingjing.example.com   # [必填] A 记录须先指向服务器公网 IP(Caddy 自动申证书)
LJ_ACME_EMAIL=                   # [可选] 证书到期通知邮箱
COOKIE_SECURE=true               # 生产经 HTTPS 必须 true;本地裸 HTTP 开发设 false
TZ=Asia/Shanghai

# ── 运行调优([可选],留空走默认)──
PORT=9372                        # app 监听端口
DB_FILE=/data/lingjing.db        # SQLite 库路径(本地开发可设 ./lingjing.db)
WORKER_POOL_SIZE=16              # 并发池:同时处理几个生成任务;4c8g 压不住可调 8
# WORKER_TENANT_MAX=             # 单租户并发上限(默认 ceil(池/2))
# POLL_TIMEOUT_MS=600000         # 数字人/图片轮询总超时(10 分钟)
# VIDEO_T2V_TIMEOUT_MS=900000    # 文生视频超时(15 分钟)

# ── 百炼模型名([可选],留空走代码默认值,一般不用动)──
# BAICHUAN_AVATAR_MODEL=wan2.2-s2v             # 数字人
# BAICHUAN_QWEN_TTS_MODEL=qwen3-tts-flash      # TTS
# BAICHUAN_QWEN_INSTRUCT_MODEL=qwen3-tts-instruct-flash
# BAICHUAN_VC_MODEL=qwen3-tts-vc-2026-01-22    # 声音复刻
# BAICHUAN_DESIGN_MODEL=qwen3-tts-vd-2026-01-26
# BAICHUAN_IMAGE_MODEL=qwen-image              # 文生图
# BAICHUAN_IMAGE_EDIT_MODEL=qwen-image-edit    # 图生图
# BAICHUAN_FUN_MUSIC_MODEL=fun-music-v1        # AI 音乐

# ── 火山方舟 私域素材库(Seedance 人脸拦截解法;默认关)──
# 开这个才会在 Seedance 视频"带脸参考图被拦"时,把图报备入库换 asset:// 绕拦截。
# 关(默认)= 行为与今天一致:无脸能生成、带脸被拦。无脸永远走首次提交成功,不入库。
ARK_ASSET_LIBRARY_ENABLED=false  # true 才启用
ARK_ASSET_AK=                    # 素材库 Access Key ID(≠ 模型调用的 ark- key;保密,勿提交)
ARK_ASSET_SK=                    # 与 AK 配对的 Secret Access Key(保密,勿提交)
ARK_ASSET_PROJECT=               # 留空=default 项目;若那把 ark- 模型 key 在自建 project,填该名字
# ARK_ASSET_GROUP=lingjing-portraits          # [可选] 素材组名
# ARK_ASSET_REGISTER_TIMEOUT_MS=90000         # [可选] 单图入库轮询超时(毫秒)
# ARK_ASSET_POLL_INTERVAL_MS=3000             # [可选] 入库轮询间隔(毫秒)
# ARK_ASSET_RETRY_ON_CODES=InputImageSensitiveContentDetected  # [可选] 触发资产化重试的拦截码
