# 灵镜 — 环境变量样板。复制为 .env 并填入真实值。
# ⚠️ .env 已被 .gitignore 忽略,绝不提交;密钥也不要贴进聊天/PR。

# 百炼 DashScope API Key(阿里云控制台开通百炼后获取)
DASHSCOPE_API_KEY=

# 可选:覆盖默认端点(私有化或区域端点时用)
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1

# 数字人视频模型(音频驱动口型)。真实模型名:wan2.2-s2v
# 留空时代码默认用 wan2.2-s2v。
BAICHUAN_AVATAR_MODEL=wan2.2-s2v
# 注:wan2.2-s2v 吃的是 image_url + audio_url,不是"预置形象ID"。
#     形象图由平台预置外链/用户上传的 MinIO 图提供,无需在此配置。
#     文案先经 CosyVoice(TTS)转音频,再喂给 wan2.2-s2v。
BAICHUAN_TTS_MODEL=cosyvoice-v2

# 探针轮询参数(可不改)
POLL_INTERVAL_MS=3000
POLL_TIMEOUT_MS=600000
