# 灵镜 — 环境变量样板。复制为 .env 并填入真实值。
# ⚠️ .env 已被 .gitignore 忽略,绝不提交;密钥也不要贴进聊天/PR。

# 百炼 DashScope API Key(阿里云控制台开通百炼后获取)
DASHSCOPE_API_KEY=

# 可选:覆盖默认端点(私有化或区域端点时用)
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1

# C-research 待补:开通数字人后,把控制台给的真实 model 名与预置形象/音色 ID 填这里
BAICHUAN_AVATAR_MODEL=
BAICHUAN_PRESET_AVATAR=
BAICHUAN_PRESET_VOICE=cosyvoice-v1

# 探针轮询参数(可不改)
POLL_INTERVAL_MS=3000
POLL_TIMEOUT_MS=600000
