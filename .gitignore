# macOS
.DS_Store

# 编辑器
.vscode/
.idea/
*.swp

# 密钥 / 环境变量（绝不提交）
# 忽略所有 .env 变体(含 .env.bak.*、.env.local、时间戳备份),但保留 .env.example。
.env
.env.*
!.env.example
*.local

# 运行时数据库（本地/部署生成,绝不提交）
*.db
*.db-shm
*.db-wal

# 依赖 / 构建产物（将来工程化时用）
node_modules/
dist/
.next/
build/
.gstack/
probe-output.mp4
probe-labeled.mp4
.gitnexus

# 示范媒体(落地页/探索/试听/形象/参考生成影片)现已**随 git 入库**(去中心化:进镜像 →
# deploy 时 seed 到运营自己 OSS;空桶/air-gap 走磁盘兜底)。故不再 ignore showcase 媒体。
# 仅排除探针测试产物(非示范素材)。
prototype/showcase/probe-*.jpg

# gstack 团队模式自动生成的准入钩子(本仓库单人/无 remote,不入库;团队协作时再放开)
.claude/settings.json
.claude/hooks/
*node_modules*

# 本地运行态产物(dev-up.sh 的 pid/log)
.run/

# AI 编码工具(superpowers 等)自动生成的计划/草稿,非项目文档,不入库
docs/superpowers/
